# y11 build graph: the C display server plus the y11_safe wire
# validators (docs/Y11_SAFE_AUDIT.md).  The plain Makefile stays the
# milestone path; this spec adds the thorn pipeline with the Rust
# archive linked in.

engine.project("y11")
engine.backend("ninja")

# The no_std validator crate: rustc -> liby11_safe.a plus the C-ABI
# audit stamp out/.thorn-rs/y11_safe.verified.
rust.crate("y11_safe", "rust/y11_safe/src/lib.rs", "include/y11_safe.h")

engine.add_target("y11", engine.exe)
engine.add_source("y11", "src/main.c")
engine.add_source("y11", "src/client.c")
engine.add_source("y11", "src/dispatch.c")
engine.add_source("y11", "src/atom.c")
engine.add_source("y11", "src/resource.c")
engine.add_source("y11", "src/events.c")
engine.add_source("y11", "src/window.c")
engine.add_source("y11", "src/pixmap.c")
engine.add_source("y11", "src/gc.c")
engine.add_source("y11", "src/render.c")
engine.add_source("y11", "src/damage.c")
engine.add_source("y11", "src/input.c")
engine.add_source("y11", "src/grab.c")
engine.add_source("y11", "src/session.c")
engine.add_source("y11", "src/drm.c")
engine.add_source("y11", "src/scanout.c")
engine.add_source("y11", "src/shm.c")
engine.add_source("y11", "src/dri3.c")
engine.add_source("y11", "src/present.c")
engine.add_source("y11", "src/property.c")
engine.add_source("y11", "src/glx.c")
engine.add_source("y11", "src/selection.c")
engine.add_source("y11", "src/xrender.c")
engine.add_source("y11", "src/evdev.c")
engine.add_source("y11", "src/xkb.c")
engine.add_source("y11", "src/cursor.c")
engine.add_source("y11", "src/saver.c")

engine.add_cflag("y11", "-std=c99")
engine.add_cflag("y11", "-pedantic")
engine.add_cflag("y11", "-Wall")
engine.add_cflag("y11", "-Wextra")
engine.add_cflag("y11", "-Werror")
engine.add_cflag("y11", "-O2")
engine.add_cflag("y11", "-D_POSIX_C_SOURCE=200809L")
# The thorn pipeline is the dual-verify shadow build: client.c runs
# the Rust framers alongside its own checks and asserts agreement.
engine.add_cflag("y11", "-DY11_DUAL_VERIFY=1")
engine.add_include("y11", "include")
engine.add_include("y11", "/usr/include/libdrm")

# The audited Rust archive rides along as a link input.
engine.add_source("y11", "out/liby11_safe.a")
engine.add_order_dep("y11", "out/.thorn-rs/y11_safe.verified")
engine.add_ldflag("y11", "-ldrm")
engine.add_ldflag("y11", "-l:libseat.so.1")

# Phase 0 smoke: the C-ABI contract against the real archive.
engine.add_target("test_safe_stub", engine.exe)
engine.add_source("test_safe_stub", "tests/test_safe_stub.c")
engine.add_source("test_safe_stub", "out/liby11_safe.a")
engine.add_order_dep("test_safe_stub", "out/.thorn-rs/y11_safe.verified")
engine.add_cflag("test_safe_stub", "-std=c99")
engine.add_cflag("test_safe_stub", "-Wall")
engine.add_cflag("test_safe_stub", "-Wextra")
engine.add_cflag("test_safe_stub", "-O2")
engine.add_include("test_safe_stub", "include")

# Phase 1 unit tests: the frozen C-ABI against the real archive.
engine.add_target("test_safe_phase1", engine.exe)
engine.add_source("test_safe_phase1", "tests/test_safe_phase1.c")
engine.add_source("test_safe_phase1", "out/liby11_safe.a")
engine.add_order_dep("test_safe_phase1", "out/.thorn-rs/y11_safe.verified")
engine.add_cflag("test_safe_phase1", "-std=c99")
engine.add_cflag("test_safe_phase1", "-Wall")
engine.add_cflag("test_safe_phase1", "-Wextra")
engine.add_cflag("test_safe_phase1", "-O2")
engine.add_include("test_safe_phase1", "include")

# Phase 2 unit tests: mask bounds, property padding, error frames.
engine.add_target("test_safe_phase2", engine.exe)
engine.add_source("test_safe_phase2", "tests/test_safe_phase2.c")
engine.add_source("test_safe_phase2", "out/liby11_safe.a")
engine.add_order_dep("test_safe_phase2", "out/.thorn-rs/y11_safe.verified")
engine.add_cflag("test_safe_phase2", "-std=c99")
engine.add_cflag("test_safe_phase2", "-Wall")
engine.add_cflag("test_safe_phase2", "-Wextra")
engine.add_cflag("test_safe_phase2", "-O2")
engine.add_include("test_safe_phase2", "include")
